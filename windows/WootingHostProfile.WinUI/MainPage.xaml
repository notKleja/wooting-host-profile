<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WootingHostProfile_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WootingHostProfile_WinUI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="20,14,20,18" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Windows profile" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Choose the configured onboard profile this PC should use."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <RadioButtons
                        x:Name="ProfilePicker"
                        Header="Configured profiles"
                        ItemsSource="{x:Bind Profiles, Mode=OneWay}">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate x:DataType="local:ProfileInfo">
                                <TextBlock Margin="0,4" Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsActive="True" />
                </Grid>
            </Border>

            <InfoBar
                Grid.Row="2"
                IsClosable="False"
                IsOpen="True"
                Message="Do not enable Wootility App Linking or another app-specific profile switcher. Those tools can replace the system profile selected here."
                Severity="Warning"
                Title="Avoid app-specific profile overrides" />

            <Border
                Grid.Row="3"
                Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="6">
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Header="Start at sign-in"
                        OffContent="The app and watcher will not start automatically"
                        OnContent="Launch hidden in the notification area" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Closing or minimizing this window keeps the app in the notification area. Double-click its tray icon to reopen it."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Reading configured profiles…"
                TextWrapping="Wrap" />

            <Grid Grid.Row="5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="Refresh_Click" Content="Refresh" />
                <Button
                    x:Name="ApplyButton"
                    Grid.Column="1"
                    Click="Apply_Click"
                    Content="Apply now"
                    IsEnabled="False" />
                <Button
                    x:Name="SaveButton"
                    Grid.Column="3"
                    Click="Save_Click"
                    Content="Save and keep running"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
